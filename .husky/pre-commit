#!/bin/bash
# Pre-commit hook to prevent secrets from being committed
# Install husky: npm install husky --save-dev
# Setup: npx husky install

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Checking for secrets in staged files...${NC}"

# Patterns to detect
declare -a PATTERNS=(
  "re_[a-zA-Z0-9]\{20,\}"           # Resend API key
  "sk_[a-zA-Z0-9]\{20,\}"           # Stripe key
  "npm_[a-zA-Z0-9]\{36\}"           # npm token
  "ghp_[a-zA-Z0-9]\{36\}"           # GitHub Personal Access Token
  "glpat-[a-zA-Z0-9\-]\{20,\}"      # GitLab token
  "RESEND_API_KEY\s*=\s*[^(test|your)][^ ]*" # Non-placeholder RESEND_API_KEY
  "API_KEY\s*=\s*[a-zA-Z0-9]"       # Generic API_KEY
  "SECRET\s*=\s*[a-zA-Z0-9]"        # Generic SECRET
  "PASSWORD\s*=\s*[a-zA-Z0-9]"      # PASSWORD assignment
  "PRIVATE_KEY\s*="                 # PRIVATE_KEY
  "BEGIN RSA PRIVATE KEY"            # RSA private key
  "BEGIN PRIVATE KEY"                # Generic private key
  "AUTHORIZATION.*Bearer\s*[a-zA-Z0-9]" # Bearer tokens
)

# Get all staged files (including newly added)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check for secrets in staged files
FOUND_SECRET=0

for file in $STAGED_FILES; do
  # Skip certain files
  if [[ $file == "package-lock.json" ]] || [[ $file == "yarn.lock" ]] || [[ $file =~ node_modules ]]; then
    continue
  fi

  # Skip .example files (they should have placeholders)
  if [[ $file == *.example ]] || [[ $file == *.example.* ]]; then
    continue
  fi

  # Check each pattern
  for pattern in "${PATTERNS[@]}"; do
    if git diff --cached "$file" | grep -E "$pattern" > /dev/null; then
      echo -e "${RED}❌ Potential secret found in: $file${NC}"
      echo -e "${RED}   Pattern: $pattern${NC}"
      git diff --cached "$file" | grep -E "$pattern" | head -3
      FOUND_SECRET=1
    fi
  done
done

# Also check for .env files being committed
if git diff --cached --name-only | grep -E "^\\.env" > /dev/null; then
  # Allow .env.example and .env.*.example
  if ! git diff --cached --name-only | grep -E "^\\.env\\..*\\.example$|^\\.env\\.example$" > /dev/null; then
    echo -e "${RED}❌ Attempt to commit .env file detected!${NC}"
    echo -e "${RED}   Never commit .env files with real secrets${NC}"
    FOUND_SECRET=1
  fi
fi

if [ $FOUND_SECRET -eq 1 ]; then
  echo ""
  echo -e "${RED}🚨 COMMIT BLOCKED: Potential secrets detected${NC}"
  echo ""
  echo -e "${YELLOW}What to do:${NC}"
  echo "1. Review the flagged files above"
  echo "2. Remove any real secrets/keys"
  echo "3. Keep only placeholder values"
  echo "4. Run: git add <fixed-files>"
  echo "5. Try commit again"
  echo ""
  echo -e "${YELLOW}If this is a false positive, use:${NC}"
  echo "git commit --no-verify"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ No secrets detected${NC}"
exit 0
